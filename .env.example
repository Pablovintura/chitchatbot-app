# Copy to .env.local for local work. In Deplexo, add the same names under Environment.
# Never commit real values.

APP_URL=https://chitchatbot.stream

# Supabase (this project's Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random 32+ character string used to sign login sessions
SESSION_SECRET=
# Random 32+ character string used to encrypt saved platform tokens (hashed to a key in code)
TOKEN_ENCRYPTION_KEY=

# Kick developer app (its own app, not PxVbot's). In the Kick app settings:
#   Redirect URL: https://chitchatbot.stream/api/kick/callback
#   Webhook URL:  https://chitchatbot.stream/api/kick/webhook   (and turn "Enable webhooks" on)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Twitch developer app (added at the Twitch milestone)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Cloudflare Workers AI (translation, added at the bot milestone)
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# Optional: the user id of the ChitChatBot bot account on Kick, so the bot never reads its own lines
KICK_BOT_USER_ID=
